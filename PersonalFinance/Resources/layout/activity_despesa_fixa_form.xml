<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/finance_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvDespesaFixaFormTitulo"
            style="@style/FinanceScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nova despesa fixa" />

        <TextView
            android:id="@+id/tvDespesaFixaFormSubtitulo"
            style="@style/FinanceScreenSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"
            android:text="O vencimento será ajustado ao último dia quando necessário." />

        <TextView
            android:id="@+id/tvDespesaFixaFormStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="ATIVA"
            android:textColor="@color/finance_success"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/FinanceFieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Receita fixa vinculada" />

            <Spinner
                android:id="@+id/spinnerDespesaFixaReceita"
                style="@style/FinanceSpinner" />

            <TextView
                style="@style/FinanceFieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Descrição" />

            <EditText
                android:id="@+id/edtDespesaFixaDescricao"
                style="@style/FinanceInput"
                android:hint="Ex.: Aluguel"
                android:inputType="textCapSentences" />

            <TextView
                style="@style/FinanceFieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Categoria" />

            <Spinner
                android:id="@+id/spinnerDespesaFixaCategoria"
                style="@style/FinanceSpinner" />

            <TextView
                style="@style/FinanceFieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Valor previsto" />

            <EditText
                android:id="@+id/edtDespesaFixaValor"
                style="@style/FinanceInput"
                android:hint="0,00"
                android:inputType="numberDecimal" />

            <TextView
                style="@style/FinanceFieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Dia de vencimento" />

            <EditText
                android:id="@+id/edtDespesaFixaDiaVencimento"
                style="@style/FinanceInput"
                android:digits="0123456789"
                android:hint="De 1 a 31"
                android:inputType="number"
                android:maxLength="2" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSalvarDespesaFixa"
            style="@style/FinanceButtonPrimary"
            android:layout_marginTop="18dp"
            android:text="Salvar despesa fixa" />

        <Button
            android:id="@+id/btnPausarDespesaFixa"
            style="@style/FinanceButtonSecondary"
            android:layout_marginTop="10dp"
            android:text="Pausar modelo"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnExcluirDespesaFixa"
            style="@style/FinanceButtonDanger"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:text="Excluir modelo"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
