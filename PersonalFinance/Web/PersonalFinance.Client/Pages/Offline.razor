@page "/offline"
@inherits FinancePage
@using System.Text.Json
<PageTitle>Sincronização</PageTitle>
<h1>Sincronização</h1><p>O Blazor consulta os dados com internet. Alterações guardadas neste navegador são enviadas ao reconectar; erros de validação precisam de revisão.</p>
<PageStatus Loading="Loading" Error="@Error" Message="@Message" Retry="ReloadAsync" />
<p>@pending.Count alteração(ões) aguardando envio.</p><div class="page-actions"><button class="btn btn-primary" disabled="@Busy" @onclick="SynchronizeNowAsync">Sincronizar agora</button></div>
@if(legacyCount>0){<div class="alert alert-warning">@legacyCount pendência(s) antigas sem conta identificada foram preservadas neste navegador. Revise-as antes de qualquer reenvio.</div>}
@foreach(var p in pending){<article class="record-card"><div><h2>@p.Title</h2><p>@p.Description</p>@if(p.Error is not null){<p class="text-danger">@p.Error</p>}<details><summary>Ver alteração preservada</summary><pre style="white-space:pre-wrap;overflow-wrap:anywhere">@p.Payload</pre></details></div><div class="record-actions">@if(p.Status=="blocked"){<button class="btn btn-sm btn-outline-primary" disabled="@Busy" @onclick="()=>RetryAsync(p.Id)">Repetir</button>}<button class="btn btn-sm btn-outline-danger" disabled="@Busy" @onclick="()=>DiscardAsync(p.Id)">Descartar pendência</button></div></article>}
@if(pending.Count==0&&!Loading){<div class="empty-state">Nenhuma pendência neste navegador. As telas abertas são atualizadas automaticamente.</div>}
@code {
 private List<PendingItem> pending=[];private int legacyCount;
 protected override async Task LoadAsync(){pending=[];legacyCount=await Api.LegacyPendingCountAsync();foreach(var raw in await Api.PendingAsync()){var x=JsonDocument.Parse(raw).RootElement;var command=x.GetProperty("command");var kind=command.GetProperty("kind").GetString()??"";var entity=command.GetProperty("entityType").GetString()??"";var label=kind switch{"Prepare"=>"Preparação mensal","Convert"=>"Conversão em fixos","Settle"=>"Quitação","Personal"=>"Gasto pessoal",_=>entity switch{"Income"=>"Receita","Expense"=>"Despesa","Payment"=>"Pagamento","FixedIncome"=>"Receita fixa","FixedExpense"=>"Despesa fixa",_=>"Lançamento"}};string description="";if(command.TryGetProperty("data",out var body)&&body.ValueKind==JsonValueKind.Object)foreach(var field in new[]{"description","note","payer"})if(body.TryGetProperty(field,out var value)&&value.ValueKind==JsonValueKind.String&&!string.IsNullOrWhiteSpace(value.GetString())){description=value.GetString()!;break;}var status=x.GetProperty("status").GetString()??"queued";var error=x.TryGetProperty("error",out var e)&&e.ValueKind==JsonValueKind.String?e.GetString():null;var payload=JsonSerializer.Serialize(command,new JsonSerializerOptions{WriteIndented=true});if(x.TryGetProperty("result",out var result)&&result.ValueKind==JsonValueKind.Object&&result.TryGetProperty("current",out var current)&&current.ValueKind==JsonValueKind.Object)payload+="\n\nVersão do servidor:\n"+JsonSerializer.Serialize(current,new JsonSerializerOptions{WriteIndented=true});pending.Add(new(x.GetProperty("id").GetString()!,label+" · "+(status=="conflict"?"conflito arquivado":status=="blocked"?"precisa de revisão":"aguardando envio"),description,status,error,payload));}}
 private Task SynchronizeNowAsync()=>RunAsync(async()=>{var sent=await Api.SynchronizeAsync();await LoadAsync();Message=$"{sent} alteração(ões) sincronizada(s).";});
 private Task RetryAsync(string id)=>RunAsync(async()=>{await Api.RetryPendingAsync(id);await Api.SynchronizeAsync();await LoadAsync();});
 private async Task DiscardAsync(string id){if(!await Js.InvokeAsync<bool>("confirm","Descartar esta alteração pendente? Ela não será enviada ao servidor. Uma gravação já aceita pelo servidor continuará no histórico."))return;await RunAsync(async()=>{await Api.RemovePendingAsync(id);await LoadAsync();});}
 private sealed record PendingItem(string Id,string Title,string Description,string Status,string? Error,string Payload);
}
