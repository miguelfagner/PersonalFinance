<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/finance_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_hero"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/btnMesAnterior"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Mês anterior"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/finance_white"
            android:textSize="34sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">

            <TextView
                android:id="@+id/tvMesAtual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="MÊS ATUAL"
                android:textColor="@color/finance_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.72"
                android:gravity="center"
                android:text="Use as setas ou deslize para navegar"
                android:textColor="@color/finance_white"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnProximoMes"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Próximo mês"
            android:focusable="true"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/finance_white"
            android:textSize="34sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvErroCarregamento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:padding="24dp"
        android:text="Não foi possível carregar os indicadores. Tente navegar novamente."
        android:textColor="@color/finance_danger_text"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scrollIndicadores"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/FinanceSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="VISÃO GERAL" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="SALDO APÓS COMPROMISSOS"
                    android:textColor="@color/finance_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSaldo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="R$ 0,00"
                    android:textColor="@color/finance_text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvResumo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="SITUAÇÃO FINANCEIRA"
                    android:textColor="@color/finance_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTotalReceita"
                        style="@style/FinanceIndicatorBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="RECEITA CADASTRADA&#10;R$ 0,00"
                        android:textColor="@color/finance_success" />

                    <TextView
                        android:id="@+id/tvTotalDespesa"
                        style="@style/FinanceIndicatorBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="COMPROMISSOS&#10;R$ 0,00"
                        android:textColor="@color/finance_danger_text" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDesvioOrcamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="QUITADO DA COMPETÊNCIA: 0%"
                    android:textColor="@color/finance_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progDespesa"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="7dp"
                    android:backgroundTint="@color/finance_surface_alt"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/finance_success" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/FinanceSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EXECUÇÃO POR CATEGORIA" />

                <TextView
                    style="@style/FinanceScreenSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:layout_marginTop="6dp"
                    android:text="Quanto já foi quitado em cada grupo de compromissos. As cinco maiores categorias aparecem primeiro." />

                <LinearLayout
                    android:id="@+id/layoutCategorias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/FinanceSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FLUXO DO MÊS" />

                <TextView
                    style="@style/FinanceScreenSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:layout_marginTop="6dp"
                    android:text="Separa as saídas pagas neste mês dos compromissos que continuam em aberto." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTotalQuitado"
                        style="@style/FinanceIndicatorBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="SAÍDAS NO MÊS&#10;R$ 0,00"
                        android:textColor="@color/finance_info" />

                    <TextView
                        android:id="@+id/tvFaltaQuitar"
                        style="@style/FinanceIndicatorBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="EM ABERTO AGORA&#10;R$ 0,00"
                        android:textColor="@color/finance_warning_text" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSaldoPlanejado"
                    style="@style/FinanceIndicatorLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="SALDO APÓS COMPROMISSOS: R$ 0,00" />

                <TextView
                    android:id="@+id/tvSaldoRealizado"
                    style="@style/FinanceIndicatorLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="RECEITA − SAÍDAS DO MÊS: R$ 0,00" />

                <TextView
                    android:id="@+id/tvComprometimentoRenda"
                    style="@style/FinanceIndicatorLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="COMPROMETIMENTO DA RENDA: 0%" />

                <TextView
                    android:id="@+id/tvPesoRecorrentes"
                    style="@style/FinanceIndicatorLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="PESO DOS COMPROMISSOS RECORRENTES: 0%" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/FinanceSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RITMO PESSOAL" />

                <TextView
                    style="@style/FinanceScreenSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:layout_marginTop="6dp"
                    android:text="Acompanha os gastos variáveis da categoria PESSOAL sem misturá-los às contas fixas." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMediaDiaria"
                        style="@style/FinanceIndicatorBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="MÉDIA PESSOAL/DIA&#10;R$ 0,00"
                        android:textColor="@color/finance_info" />

                    <TextView
                        android:id="@+id/tvLimiteDiario"
                        style="@style/FinanceIndicatorBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="DISPONÍVEL/DIA&#10;R$ 0,00"
                        android:textColor="@color/finance_success" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvProjecaoPessoal"
                    style="@style/FinanceIndicatorLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="PROJEÇÃO PESSOAL: R$ 0,00" />

                <TextView
                    android:id="@+id/tvRitmoPessoal"
                    style="@style/FinanceIndicatorLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="RITMO PESSOAL" />

                <TextView
                    android:id="@+id/tvDiasComGastoPessoal"
                    style="@style/FinanceIndicatorLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="NENHUM DIA COM GASTO PESSOAL" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/FinanceSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="STATUS DAS CONTAS" />

                <TextView
                    android:id="@+id/tvContasPendentes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="QUITADAS: 0 DE 0"
                    android:textColor="@color/finance_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progQuitacao"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="7dp"
                    android:backgroundTint="@color/finance_surface_alt"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/finance_success" />

                <TextView
                    android:id="@+id/tvDetalhePendencias"
                    style="@style/FinanceIndicatorLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="PARCIAIS: 0 · SEM PAGAMENTO: 0" />

                <TextView
                    android:id="@+id/tvContasVencidas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="NENHUMA CONTA VENCIDA"
                    android:textColor="@color/finance_success"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/FinanceSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PADRÃO DAS SAÍDAS" />

                <TextView
                    style="@style/FinanceScreenSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:layout_marginTop="6dp"
                    android:text="Mostra onde o dinheiro pago no mês ficou mais concentrado." />

                <TextView
                    android:id="@+id/tvMaiorCategoria"
                    style="@style/FinanceIndicatorBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MAIOR CATEGORIA&#10;SEM SAÍDAS NO MÊS" />

                <TextView
                    android:id="@+id/tvConcentracaoCategorias"
                    style="@style/FinanceIndicatorLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="CONCENTRAÇÃO POR CATEGORIA: SEM DADOS" />

                <TextView
                    android:id="@+id/tvTicketMedio"
                    style="@style/FinanceIndicatorBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="TICKET MÉDIO&#10;R$ 0,00" />

                <TextView
                    android:id="@+id/tvMaiorLancamento"
                    style="@style/FinanceIndicatorBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="MAIOR LANÇAMENTO&#10;SEM SAÍDAS NO MÊS" />

                <TextView
                    android:id="@+id/tvDiasComSaidas"
                    style="@style/FinanceIndicatorLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="NENHUM DIA COM SAÍDAS" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="DISTRIBUIÇÃO DAS DESPESAS PLANEJADAS"
                    android:textColor="@color/finance_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Toque em uma fatia para consultar os pagamentos da categoria feitos neste mês"
                    android:textColor="@color/finance_text_secondary"
                    android:textSize="12sp" />

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChartDespesas"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="Gráfico de distribuição das despesas planejadas por categoria"
                    android:focusable="true"
                    android:importantForAccessibility="yes" />

                <Button
                    android:id="@+id/btnVerTransacoesMes"
                    style="@style/FinanceButtonSecondary"
                    android:layout_marginTop="8dp"
                    android:text="Ver pagamentos do mês" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="CONSUMO PESSOAL SEMANAL"
                    android:textColor="@color/finance_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Toque em uma semana para ver os lançamentos"
                    android:textColor="@color/finance_text_secondary"
                    android:textSize="12sp" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChartSemanal"
                    android:layout_width="match_parent"
                    android:layout_height="340dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="Gráfico de gastos pessoais pagos por semana"
                    android:focusable="true"
                    android:importantForAccessibility="yes" />

                <Button
                    android:id="@+id/btnVerGastosPessoais"
                    style="@style/FinanceButtonSecondary"
                    android:layout_marginTop="8dp"
                    android:text="Ver gastos pessoais do mês" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
