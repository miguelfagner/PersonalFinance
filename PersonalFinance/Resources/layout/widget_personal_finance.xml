<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_personal_finance"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/widgetResumoArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clickable="true"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Gastos pessoais"
            android:textColor="@color/finance_white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/widgetCompetencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mês atual"
            android:textColor="#BFD3E3"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widgetResumoValores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="R$ 0,00 de R$ 0,00"
            android:textColor="@color/finance_white"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/widgetProgresso"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#49647B"
            android:progressTint="@color/finance_accent" />

    </LinearLayout>

    <Button
        android:id="@+id/widgetLancarGasto"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_widget_personal_finance_button"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="+ Lançar gasto"
        android:textAllCaps="false"
        android:textColor="@color/finance_primary_dark"
        android:textSize="13sp" />
</LinearLayout>
