@inherits LayoutComponentBase
@inject FinanceApi Api
@inject NavigationManager Navigation
<div class="page"><aside class="sidebar"><NavMenu /></aside><main><div class="top-row px-4"><span>Controle Financeiro</span><button class="btn btn-sm btn-outline-secondary" @onclick="LogoutAsync">Sair</button></div><article class="content px-4"><ErrorBoundary><ChildContent>@Body</ChildContent><ErrorContent><div class="alert alert-danger">Não foi possível abrir esta tela. <a href="/">Voltar ao início</a></div></ErrorContent></ErrorBoundary></article></main></div>
@code { private async Task LogoutAsync(){await Api.LogoutAsync();Navigation.NavigateTo("/login",true);} }