@inject NavigationManager Navigation
<div class="top-row navbar navbar-dark"><div class="container-fluid"><a class="navbar-brand" href="/">Controle Financeiro</a><button aria-label="Abrir menu" class="navbar-toggler" @onclick="()=>collapsed=!collapsed"><span class="navbar-toggler-icon"></span></button></div></div>
<div class="@(collapsed?"collapse":"") nav-scrollable"><nav class="nav flex-column">
@foreach(var link in links){<div class="nav-item px-3"><NavLink class="nav-link" href="@MonthLink(link.Url)" Match="@(link.Url==""?NavLinkMatch.All:NavLinkMatch.Prefix)" @onclick="()=>collapsed=true">@link.Label</NavLink></div>}
</nav></div>
@code { private string MonthLink(string page){var query=new Uri(Navigation.Uri).Query.TrimStart('?').Split('&').FirstOrDefault(x=>x.StartsWith("month="));return "/"+page+(query is null?"":"?"+query);} private bool collapsed=true;private readonly (string Url,string Label)[] links=[("","Balanço mensal"),("incomes","Receitas"),("expenses","Despesas"),("payments","Transações e pagamentos"),("open","Valores a quitar"),("personal","Gasto pessoal rápido"),("fixed","Lançamentos fixos"),("prepare","Preparar mês"),("offline","Sincronização"),("import","Backup e importação")]; }
