@page "/fixed"
@inherits FinancePage
<PageTitle>Lançamentos fixos</PageTitle>
<h1>Lançamentos fixos</h1><p class="text-muted">Modelos para preparar os próximos meses. Alterar um modelo preserva os meses já gerados.</p>
<PageStatus Loading="Loading" Error="@Error" Message="@Message" Retry="ReloadAsync" />
<div class="page-actions"><button class="btn btn-primary" @onclick="()=>income=new()">＋ Receita fixa</button><button class="btn btn-outline-primary" @onclick="NewExpense">＋ Despesa fixa</button><a class="btn btn-outline-secondary" href="@Link("fixed-convert")">Converter lançamentos</a><a class="btn btn-outline-secondary" href="/prepare">Preparar mês</a></div>
<label class="mb-3"><input type="checkbox" @bind="includePaused" /> Mostrar modelos pausados</label>
@if(income is not null){<EditForm Model="income" OnValidSubmit="SaveIncomeAsync" class="card card-body mb-4"><h2>Receita fixa</h2><div class="form-grid"><label>Fonte pagadora<InputText class="form-control" @bind-Value="income.Payer" required /></label><label>Descrição<InputText class="form-control" @bind-Value="income.Description" required /></label><label>Tipo<InputText class="form-control" @bind-Value="income.Type" required /></label><label>Valor (R$)<InputNumber class="form-control" @bind-Value="income.Amount" min="0.01" step="0.01" required /></label></div><div class="form-actions"><button class="btn btn-primary" disabled="@Busy">Salvar</button><button type="button" class="btn btn-outline-secondary" @onclick="()=>income=null">Cancelar</button></div></EditForm>}
@if(expense is not null){<EditForm Model="expense" OnValidSubmit="SaveExpenseAsync" class="card card-body mb-4"><h2>Despesa fixa</h2><div class="form-grid"><label>Receita fixa<select class="form-select" @bind="expense.FixedIncomeId" required><option value="0">Selecione</option>@foreach(var x in incomes){<option value="@x.Id">@x.Payer — @x.Description @(x.Active?"":"(pausada)")</option>}</select></label><label>Descrição<InputText class="form-control" @bind-Value="expense.Description" required /></label><label>Categoria<select class="form-select" @bind="expense.Category">@foreach(var c in CategoryOptions(expense.Category)){<option>@c</option>}</select></label><label>Valor (R$)<InputNumber class="form-control" @bind-Value="expense.Amount" min="0.01" step="0.01" required /></label><label>Dia do vencimento<InputNumber class="form-control" @bind-Value="expense.DueDay" min="1" max="31" required /></label></div><div class="form-actions"><button class="btn btn-primary" disabled="@Busy">Salvar</button><button type="button" class="btn btn-outline-secondary" @onclick="()=>expense=null">Cancelar</button></div></EditForm>}
<h2>Receitas fixas</h2><div class="records">@foreach(var x in incomes.Where(x=>includePaused||x.Active)){<article class="record-card"><div><h3>@x.Payer</h3><p>@x.Description · @x.Type</p><span class="status-badge">@(x.Active?"Ativa":"Pausada")</span></div><strong>@x.Amount.ToString("C")</strong><div class="record-actions"><button class="btn btn-sm btn-outline-primary" @onclick="()=>EditIncome(x)">Editar</button><button class="btn btn-sm btn-outline-secondary" disabled="@Busy" @onclick="()=>ToggleIncomeAsync(x)">@(x.Active?"Pausar":"Reativar")</button><button class="btn btn-sm btn-outline-danger" disabled="@Busy" @onclick='()=>DeleteAsync($"api/fixed-incomes/{x.Id}",x.Description,x)'>Excluir</button></div></article>}</div>
<h2 class="mt-4">Despesas fixas</h2><div class="records">@foreach(var x in expenses.Where(x=>includePaused||x.Active)){<article class="record-card"><div><h3>@x.Description</h3><p>@x.Category · dia @x.DueDay · @(incomes.SingleOrDefault(i=>i.Id==x.FixedIncomeId)?.Payer)</p><span class="status-badge">@(x.Active?"Ativa":"Pausada")</span></div><strong>@x.Amount.ToString("C")</strong><div class="record-actions"><button class="btn btn-sm btn-outline-primary" @onclick="()=>EditExpense(x)">Editar</button><button class="btn btn-sm btn-outline-secondary" disabled="@Busy" @onclick="()=>ToggleExpenseAsync(x)">@(x.Active?"Pausar":"Reativar")</button><button class="btn btn-sm btn-outline-danger" disabled="@Busy" @onclick='()=>DeleteAsync($"api/fixed-expenses/{x.Id}",x.Description,x)'>Excluir</button></div></article>}</div>
@if(!Loading&&incomes.Count+expenses.Count==0){<div class="empty-state">Nenhum modelo fixo cadastrado.</div>}
@code {
 private FixedIncome? income;private FixedExpense? expense;private List<FixedIncome> incomes=[];private List<FixedExpense> expenses=[];private bool includePaused;
 protected override async Task LoadAsync(){incomes=await Api.GetAsync<List<FixedIncome>>("api/fixed-incomes")??[];expenses=await Api.GetAsync<List<FixedExpense>>("api/fixed-expenses")??[];}
 private void NewExpense()=>expense=new(){DueDay=1,Category="PESSOAL"};
 private void EditIncome(FixedIncome x)=>income=new(){Id=x.Id,ClientId=x.ClientId,Revision=x.Revision,Payer=x.Payer,Description=x.Description,Type=x.Type,Amount=x.Amount,Active=x.Active};
 private void EditExpense(FixedExpense x)=>expense=new(){Id=x.Id,ClientId=x.ClientId,Revision=x.Revision,FixedIncomeId=x.FixedIncomeId,Description=x.Description,Category=x.Category,Amount=x.Amount,DueDay=x.DueDay,Active=x.Active};
 private Task SaveIncomeAsync()=>RunAsync(async()=>{if(income is null)return;await SaveAsync("api/fixed-incomes",income,income.Id);income=null;});
 private Task SaveExpenseAsync()=>RunAsync(async()=>{if(expense is null)return;await SaveAsync("api/fixed-expenses",expense,expense.Id);expense=null;});
 private async Task ToggleIncomeAsync(FixedIncome x){if(!await Js.InvokeAsync<bool>("confirm",x.Active?"Pausar esta receita e suas despesas fixas? Os meses gerados serão preservados.":"Reativar esta receita? As despesas continuarão pausadas."))return;await RunAsync(async()=>{EditIncome(x);income!.Active=!x.Active;await SaveAsync("api/fixed-incomes",income,income.Id);income=null;});}
 private Task ToggleExpenseAsync(FixedExpense x)=>RunAsync(async()=>{EditExpense(x);expense!.Active=!x.Active;await SaveAsync("api/fixed-expenses",expense,expense.Id);expense=null;});
}
