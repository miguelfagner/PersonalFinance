<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/finance_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/FinanceScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preparar mês" />

        <TextView
            style="@style/FinanceScreenSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="18dp"
            android:text="Escolha a competência, revise os modelos e ajuste somente o mês selecionado." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/FinanceFieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Competência" />

            <EditText
                android:id="@+id/edtCompetenciaPreparacao"
                style="@style/FinanceInput"
                android:clickable="true"
                android:focusable="false"
                android:hint="MM/AAAA" />

            <Button
                android:id="@+id/btnCarregarPreparacao"
                style="@style/FinanceButtonSecondary"
                android:layout_marginTop="12dp"
                android:text="Carregar modelos" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvResumoPreparacao"
            style="@style/FinanceCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Nenhum modelo carregado" />

        <TextView
            style="@style/FinanceSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="RECEITAS FIXAS" />

        <LinearLayout
            android:id="@+id/containerReceitasPreparacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            style="@style/FinanceSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="DESPESAS FIXAS" />

        <LinearLayout
            android:id="@+id/containerDespesasPreparacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnGerarPreparacao"
            style="@style/FinanceButtonPrimary"
            android:layout_marginTop="22dp"
            android:enabled="false"
            android:text="Gerar lançamentos" />

        <Button
            android:id="@+id/btnCancelarPreparacao"
            style="@style/FinanceButtonSecondary"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:text="Cancelar" />
    </LinearLayout>
</ScrollView>
