@page "/payments"
@inherits FinancePage
<PageTitle>Transações e pagamentos</PageTitle>
<MonthHeader Title="Transações e pagamentos" Date="MonthValue" Change="ChangeMonthAsync" />
<PageStatus Loading="Loading" Error="@Error" Message="@Message" Retry="ReloadAsync" />
<div class="page-actions"><button class="btn btn-primary" @onclick="New">＋ Registrar pagamento</button><a class="btn btn-outline-secondary" href="@Link("personal")">Gasto pessoal rápido</a></div>
<div class="filter-bar"><label>Categoria<select class="form-select" @bind="category" @bind:after="ReloadAsync"><option value="">Todas</option>@foreach(var c in CategoryOptions(category)){<option>@c</option>}</select></label><label>Despesa<select class="form-select" @bind="expenseId" @bind:after="ReloadAsync"><option value="0">Todas</option>@foreach(var x in expenses){<option value="@x.Expense.Id">@x.Expense.Description</option>}</select></label><label>Semana pessoal<select class="form-select" @bind="week" @bind:after="ReloadAsync"><option value="0">Todas</option>@for(var i=1;i<=6;i++){<option value="@i">Semana @i</option>}</select></label></div>
@if(editing is not null){<div class="input-group mb-3"><input class="form-control" placeholder="Buscar despesa de qualquer competência" aria-label="Buscar despesa" @bind="expenseSearch" /><button type="button" class="btn btn-outline-secondary" @onclick="SearchExpensesAsync">Buscar</button></div>}
@if(editing is not null){<EditForm Model="editing" OnValidSubmit="SaveRecordAsync" class="card card-body mb-4"><DataAnnotationsValidator /><ValidationSummary /><h2>@(editing.Id==0?"Novo pagamento":"Editar pagamento")</h2><div class="form-grid"><label>Despesa<select class="form-select" @bind="editing.ExpenseId" required><option value="0">Selecione</option>@foreach(var x in expenses){<option value="@x.Expense.Id">@x.Expense.Description — restante @x.Remaining.ToString("C")</option>}</select></label><label>Observação<InputText class="form-control" @bind-Value="editing.Note" /></label><label>Valor (R$)<InputNumber class="form-control" @bind-Value="editing.Amount" min="0.01" step="0.01" required /></label><label>Data<InputDate class="form-control" @bind-Value="editing.Date" required /></label></div><div class="form-actions"><button class="btn btn-primary" disabled="@Busy">Salvar</button><button type="button" class="btn btn-outline-secondary" @onclick="()=>editing=null">Cancelar</button></div></EditForm>}
@if(!Loading && items.Count==0){<div class="empty-state">Nenhum pagamento encontrado.</div>}
@foreach(var group in items.GroupBy(x=>x.Payment.Date)){
<div class="day-heading"><h2>@group.Key.ToString("dd/MM/yyyy")</h2><strong>@group.Sum(x=>x.Payment.Amount).ToString("C")</strong></div>
<div class="records">@foreach(var item in group){<article class="record-card"><div><h3>@item.Expense</h3><p>@item.Payment.Note</p><small>@item.Category · @item.Payer</small></div><strong class="record-amount">@item.Payment.Amount.ToString("C")</strong><div class="record-actions"><button class="btn btn-sm btn-outline-primary" @onclick="()=>Edit(item.Payment)">Detalhes / editar</button><button class="btn btn-sm btn-outline-danger" disabled="@Busy" @onclick='()=>DeleteAsync($"api/payments/{item.Payment.Id}",item.Payment.Note,item.Payment)'>Excluir</button></div></article>}</div>
}
<p class="list-total">Total de pagamentos <strong>@items.Sum(x=>x.Payment.Amount).ToString("C")</strong></p>
@code {
    private List<PaymentListItem> items=[]; private List<ExpenseListItem> expenses=[];private Payment? editing;private string category="";private string categories="";private string expenseSearch="";private int expenseId;private int week;private bool dueMonthOnly;private bool openNew;
    protected override Task InitializeAsync(){int.TryParse(Query("expenseId"),out expenseId);int.TryParse(Query("week"),out week);category=Query("category")??"";categories=Query("categories")??"";dueMonthOnly=Query("personalDueMonth")=="true";openNew=Query("new")=="1";return Task.CompletedTask;}
    protected override async Task LoadAsync(){items=await Api.GetAsync<List<PaymentListItem>>($"api/payments?year={Month.Year}&month={Month.Month}"+(expenseId>0?$"&expenseId={expenseId}":"")+(week>0?$"&week={week}":"")+"&category="+Uri.EscapeDataString(category)+"&categories="+Uri.EscapeDataString(categories)+(dueMonthOnly?"&personalDueMonth=true":""))??[];expenses=await Api.GetAsync<List<ExpenseListItem>>($"api/expenses/{Month.Year}/{Month.Month}")??[];foreach(var id in items.Select(x=>x.Payment.ExpenseId).Append(expenseId).Where(x=>x>0).Distinct()){if(expenses.Any(x=>x.Expense.Id==id))continue;var e=await Api.GetAsync<Expense>($"api/expenses/{id}");if(e is not null)expenses.Add(new(e,e.Payments.Sum(x=>x.Amount),Math.Max(0,e.Amount-e.Payments.Sum(x=>x.Amount)),""));}if(openNew){openNew=false;New();}}
    private void New(){var selected=expenses.FirstOrDefault(x=>x.Expense.Id==expenseId);editing=new(){ExpenseId=expenseId,Date=selected?.Expense.DueDate??DateOnly.FromDateTime(DateTime.Today),Amount=selected?.Remaining??0,Note=selected?.Expense.Description??""};}
    private Task SearchExpensesAsync()=>RunAsync(async()=>{var found=await Api.GetAsync<List<ExpenseListItem>>("api/lookups/expenses?q="+Uri.EscapeDataString(expenseSearch))??[];expenses=expenses.Concat(found).DistinctBy(x=>x.Expense.Id).OrderByDescending(x=>x.Expense.DueDate).ToList();});
    private void Edit(Payment p)=>editing=new(){Id=p.Id,ClientId=p.ClientId,Revision=p.Revision,ExpenseId=p.ExpenseId,Amount=p.Amount,Date=p.Date,Note=p.Note};
    private Task SaveRecordAsync()=>RunAsync(async()=>{if(editing is null)return;editing.ExpenseClientId=expenses.FirstOrDefault(x=>x.Expense.Id==editing.ExpenseId)?.Expense.ClientId;await SaveAsync("api/payments",editing,editing.Id);editing=null;});
}
