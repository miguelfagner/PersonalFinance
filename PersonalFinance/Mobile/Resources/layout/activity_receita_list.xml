<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/finance_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/monthly_list_header" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/listReceitas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="10dp"
                android:padding="12dp"
                android:paddingBottom="88dp"
                android:visibility="gone" />

            <include layout="@layout/monthly_list_status" />
        </FrameLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnAddReceita"
        style="@style/FinanceFab"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp"
        android:contentDescription="Adicionar receita"
        android:text="+" />
</FrameLayout>
