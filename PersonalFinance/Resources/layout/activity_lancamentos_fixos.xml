<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/finance_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/FinanceScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lançamentos fixos" />

        <TextView
            style="@style/FinanceScreenSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"
            android:text="Cadastre os modelos que serão usados para preparar cada mês." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/FinanceCardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Receitas fixas" />

            <TextView
                style="@style/FinanceScreenSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Salários, benefícios e outras entradas recorrentes." />

            <Button
                android:id="@+id/btnGerenciarReceitasFixas"
                style="@style/FinanceButtonSecondary"
                android:layout_marginTop="16dp"
                android:text="Gerenciar receitas fixas" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:elevation="1dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/FinanceCardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Despesas fixas" />

            <TextView
                style="@style/FinanceScreenSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Contas e compromissos que se repetem todos os meses." />

            <Button
                android:id="@+id/btnGerenciarDespesasFixas"
                style="@style/FinanceButtonSecondary"
                android:layout_marginTop="16dp"
                android:text="Gerenciar despesas fixas" />
        </LinearLayout>

        <Button
            android:id="@+id/btnImportarLancamentosFixos"
            style="@style/FinanceButtonSecondary"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="12dp"
            android:text="Importar de lançamentos existentes" />
    </LinearLayout>
</ScrollView>
